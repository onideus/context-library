{
  "name": "context-library",
  "version": "0.0.0-development",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract-entities": "tsx scripts/extract-entities.ts",
    "compact-history": "tsx scripts/compact-history.ts",
    "audit-compaction": "tsx scripts/audit-compaction.ts",
    "rehydrate-handoffs": "tsx scripts/rehydrate-handoffs.ts",
    "export": "tsx scripts/export.ts",
    "import": "tsx scripts/import.ts",
    "reindex": "tsx scripts/reindex.ts"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "path-to-regexp": "8.4.2",
    "fast-uri": "3.1.8",
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
